          "rawSql": "select p.product_category_name_english as product_category_name, count(distinct f.order_id) as total_orders, sum(f.price) as total_revenue, round(avg(r.review_score), 2) as average_customer_ratings from public.fact_order_items f join public.dim_products p on f.product_id = p.product_id left join public.dim_reviews r on f.review_id = r.review_id group by p.product_category_name_english order by total_revenue desc;",
