      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Total Revenue by State",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "PostgreSQL"
